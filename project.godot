; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Forgotten Judgements"
run/main_scene="uid://boyko0mj15w8q"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"bartender": "res://dialogic/characters/bartender.dch",
"unit_test_character": "res://Tests/Resources/unit_test_character.dch"
}
directories/dtl_directory={
"bartender": "res://dialogic/timelines/bartender.dtl",
"bartender_warning": "res://dialogic/timelines/bartender_warning.dtl"
}
layout/style_directory={}
variables={
"bartender": {
"HAS_WARNING_RUN": false,
"TRIED_TO_EXIT": false
}
}
glossary/default_case_sensitive=true

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[importer_defaults]

scene={
"_subresources": {
"nodes": {
"PATH:wall-corner-rounded-low": {
"generate/physics": true
}
}
},
"animation/fps": 30,
"animation/import": true,
"animation/import_rest_as_RESET": false,
"animation/remove_immutable_tracks": true,
"animation/trimming": false,
"array_mesh/deduplicate_surfaces": true,
"gltf/embedded_image_handling": 1,
"gltf/naming_version": 2,
"gltf/texture_map_mode": 1,
"import_script/path": "",
"materials/extract": 0,
"materials/extract_format": 0,
"materials/extract_path": "",
"mesh_library/use_node_names_as_mesh_names": false,
"meshes/create_shadow_meshes": true,
"meshes/ensure_tangents": true,
"meshes/force_disable_compression": false,
"meshes/generate_lods": true,
"meshes/light_baking": 1,
"meshes/lightmap_texel_size": 0.2,
"nodes/apply_root_scale": true,
"nodes/import_as_skeleton_bones": false,
"nodes/root_name": "",
"nodes/root_scale": 1.0,
"nodes/root_script": null,
"nodes/root_type": "",
"nodes/use_name_suffixes": true,
"nodes/use_node_type_suffixes": true,
"skins/use_named_skins": true
}

