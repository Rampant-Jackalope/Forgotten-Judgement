}
directories/dtl_directory={
"bartender": "res://dialogic/timelines/bartender/bartender.dtl",
"introduction-warning": "res://dialogic/timelines/overworker/introduction-warning.dtl",
"misc-popups": "res://dialogic/timelines/misc-popups.dtl",
"overworker-warning": "res://dialogic/timelines/overworker/overworker-warnings.dtl",
